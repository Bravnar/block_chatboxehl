{
    "name": "bravnar/chatboxehl",
    "authors": [
        {
            "name": "Bravnar",
            "email": "stan.muravyev@bluewin.ch"
        }
    ],
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "moodlehq/moodle-cs": "^3.7",
        "phpcsstandards/phpcsextra": "^1.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=moodle --ignore=vendor .",
        "fix": "phpcbf --standard=moodle --ignore=vendor ."
    }
}
